# DataSphere runtime configuration. Copy to .run/datasphere.env or config/datasphere.env.
SPRING_PROFILES_ACTIVE=prod
DATASPHERE_PORT=8080

DATASPHERE_DB_URL='jdbc:mysql://127.0.0.1:3306/datasphere?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
DATASPHERE_DB_USERNAME=datasphere
DATASPHERE_DB_PASSWORD='change-me'
DATASPHERE_DB_POOL_SIZE=20

DATASPHERE_AUTH_ENABLED=true
DATASPHERE_ADMIN_USERNAME=admin
DATASPHERE_ADMIN_INITIAL_PASSWORD='change-this-on-first-start'
DATASPHERE_SESSION_TTL_MINUTES=480
DATASPHERE_CREDENTIAL_MASTER_KEY='replace-with-a-long-random-secret'

DATASPHERE_SCHEDULER_TYPE=local
SEATUNNEL_HOME=/data/software/seatunnel
SEATUNNEL_REAL_ENABLED=true

# Only required when DATASPHERE_SCHEDULER_TYPE=dolphinscheduler
DOLPHINSCHEDULER_REAL_ENABLED=false
DOLPHINSCHEDULER_BASE_URL=http://127.0.0.1:12345
DOLPHINSCHEDULER_USERNAME=admin
DOLPHINSCHEDULER_PROJECT_CODE=datasphere
DOLPHINSCHEDULER_TENANT_CODE=datasphere
DOLPHINSCHEDULER_PASSWORD=''
DOLPHINSCHEDULER_TOKEN=''
